streaming:
  blocks:
    - private_yacht\all.streamingblock
    - private_yacht\yacht_routes.streamingblock
  sectors:
    # Delete unatural meshes and collisions over the sea.
    - path: base\worlds\03_night_city\_compiled\default\exterior_-22_-2_0_1.streamingsector
      expectedNodes: 180
      nodeDeletions:
        - index: 178
          type: worldStaticMeshNode
        - index: 179
          type: worldCollisionNode
    - path: base\worlds\03_night_city\_compiled\default\exterior_-19_8_0_1.streamingsector
      expectedNodes: 189
      nodeDeletions:
        - index: 187
          type: worldStaticMeshNode
        - index: 188
          type: worldCollisionNode
quest:
  phases:
    - path: private_yacht\quests\private_yacht_main.questphase
      parent: base\quest\cyberpunk2077.quest
    - path: private_yacht\quests\private_yacht_main.questphase
      parent: ep1\quest\ep1_standalone.quest
localization:
